# pixi environments (pixi's template: the env is ignored, a per-checkout
# .pixi/config.toml is not)
.pixi/*
!.pixi/config.toml

# Rust build artifacts: the workspace's target/ (native/target before
# 2026-09-06) and experiments/'s own workspace's
target/

# Compiled native binaries / libs (rebuilt from source)
*.dylib
*.so
*.dll
*.rlib

# Python
__pycache__/
*.pyc

# Node
node_modules/

# macOS
.DS_Store
out/tooling-ab/sweep/
out/*.json.gz
out/*.json.syms.json
out/*.png
out/windowed-shot-*.png

# Agent worktrees — each is its own git repo plus a ~2.5 GB toolchain.
# `git add -A` will otherwise commit them as gitlinks (it did, 289ada8).
# Everything else under .claude/ is per machine too, except the skills
# Claude Code loads, which are tracked links into .agents/skills/.
/.claude/*
!/.claude/skills/

# Derived atlas mip cache
assets/atlas/*.cache
*.cache

# Per-machine settings. launch_config.example.toml is the tracked template;
# each checkout copies it to launch_config.toml and edits it for that machine.
/launch_config.toml
native/launch_config.toml

# experiments/zed is a per-machine symlink to a Zed checkout (experiments/Cargo.toml)
/experiments/zed


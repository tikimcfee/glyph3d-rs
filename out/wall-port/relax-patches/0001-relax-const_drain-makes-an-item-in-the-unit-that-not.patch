+const DRAIN_UNIT_SOURCE: &str = r#"
+const K1: u32 = 40 + 2;
+pub fn root(x: u32) -> u32 { x.wrapping_add(K1) }
+fn main() {
+    let _ = root(1);
+}
+"#;
+
+const DRAIN_OTHER_SOURCE: &str = r#"
+fn main() {}
+"#;
+
+/// The owner's drain makes an item in the unit that noted it, whichever unit's code the owner runs
+/// when the drain is served. A proc macro's call puts the owner inside the macro world's unit
+/// (call_jit_in: that unit is the thread's), a wait in there serves the const_drain request of a
+/// program front, and the drain read the program's ids in the macro world's program: a host
+/// SIGSEGV in Unit::vtable / Unit::const_addr while a warm start built the macro world beside the
+/// running program (2026-11-26).
+#[test]
+fn the_drain_makes_an_item_in_the_unit_that_noted_it() {
+    isolated_test!(the_drain_makes_an_item_in_the_unit_that_noted_it);
+    crate::borrowck::lazy::disable_gandalf();
+    if std::env::var_os("RELAX_STD").is_none() {
+        std::env::set_var("RELAX_STD", concat!(env!("CARGO_MANIFEST_DIR"), "/std"));
+    }
+    let dir = std::env::temp_dir().join(format!("relax-drain-unit-{}", std::process::id()));
+    std::fs::create_dir_all(&dir).unwrap();
+    let unit_of = |name: &str, source: &str| {
+        let path = dir.join(format!("{name}.rs"));
+        std::fs::write(&path, source).unwrap();
+        let (prog, core, krate) = crate::load_with_std(&std::sync::Arc::new(crate::Session::default()), path.to_str().unwrap(), name, false).unwrap();
+        let k1 = prog.defs.iter().enumerate().find_map(|(i, d)| {
+            let id = DefId(i as u32);
+            (d.krate == krate && d.kind == DefKind::Const && prog.name(id) == "K1").then_some(id)
+        });
+        let mut tcx = Tcx::new();
+        tcx.collect(&prog);
+        assert!(tcx.errors.is_empty(), "{:?}", tcx.errors);
+        (Unit::new(prog, tcx, core), k1)
+    };
+    // the program's unit, the runtime's
+    let (mut u, k1) = unit_of("drain_unit", DRAIN_UNIT_SOURCE);
+    let k1 = k1.unwrap();
+    let up = &mut *u as *mut Unit;
+    unsafe { UNIT = up };
+    // another unit with a program of its own, as the proc-macro world's is: K1's id is none of its
+    let (mut w, _) = unit_of("drain_other", DRAIN_OTHER_SOURCE);
+    w.aux = true;
+    let wp = &mut *w as *mut Unit as usize;
+    assert!((k1.0 as usize) >= w.prog.defs.len() || w.prog.def(k1).kind != DefKind::Const, "the fixture's constant is one in the other program too");
+    let (epoch, other_epoch) = crate::owner::call(crate::owner::Class::Program, || (u.tcx.collect_epoch.load(Ordering::SeqCst), w.tcx.collect_epoch.load(Ordering::SeqCst)));
+    assert_eq!(epoch, other_epoch, "the epochs differ: the drain's epoch check alone would drop the item");
+    assert!(crate::owner::call(crate::owner::Class::Program, || u.front.consts.get(&(k1, Vec::new())).is_none()), "K1 was evaluated before the drain");
+    // a program front notes K1; the owner's drain is served while it runs the other unit's code
+    want(unsafe { &*up }, Wanted::Const(k1, Vec::new()), epoch);
+    crate::owner::call(crate::owner::Class::Job, move || {
+        let prev = CUR_UNIT.with(|c| c.replace(wp as *mut Unit));
+        const_drain();
+        CUR_UNIT.with(|c| c.set(prev));
+    });
+    assert!(crate::owner::call(crate::owner::Class::Program, || u.front.consts.get(&(k1, Vec::new())).is_some()), "the drain did not make K1 in the unit that noted it");
+    // (process exit owns the runtime's teardown)
+    std::mem::forget(u);
+    std::mem::forget(w);
+    std::fs::remove_dir_all(dir).unwrap();
+}

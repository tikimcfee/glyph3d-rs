+            || up == unsafe { UNIT }
+            || up == crate::run::running_unit()
+            || (AUX_UNITS_ANY.load(Ordering::Acquire) && AUX_UNITS.lock().unwrap_or_else(|e| e.into_inner()).contains(&(up as usize))))

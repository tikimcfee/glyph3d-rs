+    #[test]
+    fn pty_child_gets_clean_default_signals_flags_and_empty_mask() {
+        let _turn = crate::FORKS.lock().unwrap_or_else(|e| e.into_inner());
+        unsafe {
+            // Simulate holder + odd starter state in a forked subtest parent so libtest's own
+            // signal handlers are never mutated.
+            let sub = libc::fork();
+            assert!(sub >= 0);
+            if sub == 0 {
+                for sig in [libc::SIGPIPE, libc::SIGINT, libc::SIGQUIT, libc::SIGTSTP, libc::SIGHUP] {
+                    libc::signal(sig, libc::SIG_IGN);
+                }
+                let mut sa_chld: libc::sigaction = std::mem::zeroed();
+                sa_chld.sa_sigaction = libc::SIG_DFL;
+                sa_chld.sa_flags = libc::SA_NOCLDSTOP | libc::SA_RESTART;
+                libc::sigemptyset(&mut sa_chld.sa_mask);
+                libc::sigaction(libc::SIGCHLD, &sa_chld, std::ptr::null_mut());
+
+                let mut block: libc::sigset_t = std::mem::zeroed();
+                libc::sigemptyset(&mut block);
+                for sig in [libc::SIGINT, libc::SIGQUIT, libc::SIGTERM, libc::SIGHUP, libc::SIGPIPE, libc::SIGALRM] {
+                    libc::sigaddset(&mut block, sig);
+                }
+                libc::sigprocmask(libc::SIG_BLOCK, &block, std::ptr::null_mut());
+
+                super::reset_signals_for_test();
+                for sig in 1..super::max_sig_for_test() {
+                    if sig == libc::SIGKILL || sig == libc::SIGSTOP {
+                        continue;
+                    }
+                    let mut sa: libc::sigaction = std::mem::zeroed();
+                    if libc::sigaction(sig, std::ptr::null(), &mut sa) == 0 {
+                        if sa.sa_sigaction != libc::SIG_DFL || sa.sa_flags != 0 {
+                            libc::_exit(sig);
+                        }
+                    }
+                }
+                let mut cur: libc::sigset_t = std::mem::zeroed();
+                libc::sigprocmask(libc::SIG_SETMASK, std::ptr::null(), &mut cur);
+                for sig in 1..super::max_sig_for_test() {
+                    if libc::sigismember(&cur, sig) == 1 {
+                        libc::_exit(100 + sig);
+                    }
+                }
+                libc::_exit(0);
+            }
+            let mut st = 0;
+            let w = libc::waitpid(sub, &mut st, 0);
+            assert_eq!(w, sub);
+            assert!(
+                libc::WIFEXITED(st) && libc::WEXITSTATUS(st) == 0,
+                "child signal check failed on sig/code={}",
+                libc::WEXITSTATUS(st)
+            );
+        }
+
+        // Check across actual PTY spawn + execve with bounded wait:
+        let argv = [
+            "sh".to_owned(),
+            "-c".to_owned(),
+            "yes | head -c 64 >/dev/null; echo PIPE_OK:$?; (exit 7) & p=$!; wait $p; echo WAIT_OK:$?".to_owned(),
+        ];
+        let plan = Plan::new("/bin/sh", &argv, &[("PATH".into(), "/usr/bin:/bin".into())], None, 80, 24).unwrap();
+        let (master, pid) = spawn(&plan, 1024, None).unwrap();
+        rustix::fs::fcntl_setfl(&master, rustix::fs::OFlags::NONBLOCK).unwrap();
+        let mut out = Vec::new();
+        let mut buf = [0u8; 4096];
+        let until = Instant::now() + Duration::from_secs(3);
+        let mut reaped = false;
+        while Instant::now() < until {
+            match rustix::io::read(&master, &mut buf) {
+                Ok(0) => break,
+                Ok(n) => out.extend_from_slice(&buf[..n]),
+                Err(rustix::io::Errno::AGAIN) => {
+                    let mut st = 0;
+                    if unsafe { libc::waitpid(pid, &mut st, libc::WNOHANG) } == pid {
+                        reaped = true;
+                        break;
+                    }
+                    std::thread::sleep(Duration::from_millis(10));
+                }
+                Err(_) => break,
+            }
+        }
+        if !reaped {
+            let mut st = 0;
+            if unsafe { libc::waitpid(pid, &mut st, libc::WNOHANG) } != pid {
+                unsafe { libc::kill(-pid, libc::SIGKILL) };
+                unsafe { libc::waitpid(pid, &mut st, 0) };
+                panic!("PTY pipeline hung (SIGPIPE likely ignored); output={:?}", String::from_utf8_lossy(&out));
+            }
+        }
+        let text = String::from_utf8_lossy(&out);
+        assert!(text.contains("PIPE_OK:0"), "{text:?}");
+        assert!(text.contains("WAIT_OK:7"), "{text:?}");
+    }
 }

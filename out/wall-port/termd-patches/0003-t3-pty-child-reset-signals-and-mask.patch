+/// Exclusive upper bound of valid signal numbers (`_NSIG`: 65 on Linux/Android covering standard
+/// 1..=31 and real-time 32..=64; 32 on macOS/BSD covering 1..=31).
+#[cfg(any(target_os = "linux", target_os = "android"))]
+pub const NSIG_LIMIT: i32 = 65;
+#[cfg(not(any(target_os = "linux", target_os = "android")))]
+pub const NSIG_LIMIT: i32 = 32;
+
+/// Resets every catchable/ignorable signal disposition (`1..NSIG_LIMIT`, including `SIGPIPE`,
+/// `SIGINT`, `SIGQUIT`, `SIGTSTP`, `SIGTTIN`, `SIGTTOU`, `SIGCHLD`, `SIGHUP`, `SIGTERM`, and
+/// Linux real-time signals) to `SIG_DFL` with `sa_flags = 0` and an empty `sa_mask` via
+/// async-signal-safe `sigaction(2)`, then clears the process signal mask (`SIG_SETMASK`).
+///
+/// # Safety
+/// Async-signal-safe; intended for forked children prior to `execve`.
+pub unsafe fn reset_signals_and_mask() {
+    unsafe {
+        let mut sa: libc::sigaction = std::mem::zeroed();
+        sa.sa_sigaction = libc::SIG_DFL;
+        sa.sa_flags = 0;
+        libc::sigemptyset(&mut sa.sa_mask);
+        for sig in 1..NSIG_LIMIT {
+            if sig != libc::SIGKILL && sig != libc::SIGSTOP {
+                // Unusable internal signals (e.g. NPTL 32/33 on glibc) return EINVAL and are skipped.
+                libc::sigaction(sig, &sa, std::ptr::null_mut());
+            }
+        }
+        let mut set: libc::sigset_t = std::mem::zeroed();
+        libc::sigemptyset(&mut set);
+        libc::sigprocmask(libc::SIG_SETMASK, &set, std::ptr::null_mut());
+    }
+}
+
+#[cfg(test)]
+unsafe fn reset_signals_for_test() {
+    unsafe { reset_signals_and_mask() }
+}
+
+#[cfg(test)]
+const fn max_sig_for_test() -> i32 {
+    NSIG_LIMIT
+}

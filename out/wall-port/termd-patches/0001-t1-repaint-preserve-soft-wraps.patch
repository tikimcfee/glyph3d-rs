From d33b2f90098510a19ee65368a89d5ac392ec1702 Mon Sep 17 00:00:00 2001
From: wall-vt <wall-vt@local>
Date: Thu, 26 Nov 2026 17:49:10 -0600
Subject: [PATCH 1/3] t1: repaint preserve soft wraps

Pass `unwrap = true` to `libghostty-vt`'s `PageFormatter` in `repaint::live` for
both scrollback history and the active screen so soft-wrapped rows omit hard
`\r\n` breaks and preserve `row.wrap` across mid-session repaints and subsequent
viewer reflows (`repaint::view` stays `unwrap = false` so a bottom-right
wide-spacer advance cannot shift a mid-scrollback viewport).

Includes `repaint_preserves_soft_wraps_and_reflows_identically` in
`crates/g3d-termd/tests/daemon.rs`.
---
 crates/g3d-termd/src/repaint.rs  |  7 ++--
 crates/g3d-termd/tests/daemon.rs | 56 ++++++++++++++++++++++++++++++++
 2 files changed, 61 insertions(+), 2 deletions(-)

diff --git a/crates/g3d-termd/src/repaint.rs b/crates/g3d-termd/src/repaint.rs
index 55f1891..94e0f96 100644
--- a/crates/g3d-termd/src/repaint.rs
+++ b/crates/g3d-termd/src/repaint.rs
@@ -69,7 +69,7 @@ pub fn live(t: &mut Term, history_rows: u32) -> Vec<u8> {
             Format::Vt,
             Extras::NONE,
             true,
-            false,
+            true,
         );
         out.extend_from_slice(&hist);
         out.extend_from_slice(b"\x1b[0m\r\n");
@@ -87,6 +87,9 @@ pub fn live(t: &mut Term, history_rows: u32) -> Vec<u8> {
     if sync {
         let _ = t.set_mode(Mode::SYNC_OUTPUT, false);
     }
+    // `unwrap: true` omits hard `\r\n` after soft-wrapped rows so a viewer's autowrap (set on by
+    // PREAMBLE, or restored by `Extras::ALL`) reconstructs `row.wrap` rather than turning every
+    // wrapped line into hard line breaks.
     let screen = format_range(
         t,
         Point::Active(Coordinate { x: 0, y: 0 }),
@@ -94,7 +97,7 @@ pub fn live(t: &mut Term, history_rows: u32) -> Vec<u8> {
         Format::Vt,
         Extras::ALL & !Extras::PALETTE,
         false,
-        false,
+        true,
     );
     if sync {
         let _ = t.set_mode(Mode::SYNC_OUTPUT, true);
diff --git a/crates/g3d-termd/tests/daemon.rs b/crates/g3d-termd/tests/daemon.rs
index 0f1ff5c..caf48cc 100644
--- a/crates/g3d-termd/tests/daemon.rs
+++ b/crates/g3d-termd/tests/daemon.rs
@@ -1035,3 +1035,59 @@ fn a_daemonized_log_rotates_and_the_brain_follows() {
         std::thread::sleep(Duration::from_millis(50));
     }
 }
+
+fn plain_unwrapped(t: &libghostty_vt::Terminal) -> String {
+    use libghostty_vt::fmt::{Extras, Format, Formatter};
+    use libghostty_vt::point::{Coordinate, Point};
+    use libghostty_vt::selection::Selection;
+    let mut f = Formatter::new(t).unwrap();
+    f.set_format(Format::Plain).unwrap().set_extras(Extras::NONE).unwrap().set_trim(true).unwrap();
+    f.set_unwrap(true).unwrap();
+    let (c, r) = (t.cols().unwrap(), t.rows().unwrap() as u32);
+    let a = t.grid_ref(Point::Active(Coordinate { x: 0, y: 0 })).unwrap();
+    let b = t.grid_ref(Point::Active(Coordinate { x: c - 1, y: r - 1 })).unwrap();
+    let sel = Selection::new(a, b, false);
+    unsafe { f.set_selection(Some(&sel)).unwrap() };
+    String::from_utf8_lossy(&f.format_alloc(None).unwrap()).into_owned()
+}
+
+/// T1: A mid-session `REPAINT` must preserve soft-wrap metadata (`row.wrap`), not turn wrapped
+/// rows into hard `\r\n` line breaks — both for unwrapped logical-line text extraction and for
+/// subsequent resize reflow on the viewer.
+#[test]
+fn repaint_preserves_soft_wraps_and_reflows_identically() {
+    let d = Daemon::start();
+    let mut c = d.client();
+    // 60-col terminal:
+    // - 95-char styled ASCII line soft-wrapping across 2 rows;
+    // - 59-char prefix + wide CJK ("漢語tail") triggering a col-59 spacer-head soft wrap;
+    // - explicit hard newline + READY.
+    let script = format!(
+        "stty -opost; printf '\\033[32m{}\\033[0m\\r\\n{}漢語tail\\r\\nHARD\\r\\nREADY'; exec sleep 100",
+        "a".repeat(55) + &"b".repeat(40),
+        "x".repeat(59),
+    );
+    create(&mut c, "t", &["sh", "-c", &script], 60, 12);
+    let _early = subscribe(&mut c, "t", Role::Attach, None);
+    let mut truth = Seen::default();
+    read_until(&mut c, &mut truth, 10, |s| contains(&s.bytes, b"READY"));
+
+    let mut late_c = d.client();
+    let _late = subscribe(&mut late_c, "t", Role::Watch, None);
+    let mut seen = Seen::default();
+    read_until(&mut late_c, &mut seen, 10, |s| !s.repaints.is_empty());
+
+    let mut a = viewer(60, 12, &truth.bytes);
+    let mut b = viewer(60, 12, &seen.bytes);
+    assert_eq!(plain(&a), plain(&b), "60x12 visual rows differ");
+    assert_eq!(
+        plain_unwrapped(&a),
+        plain_unwrapped(&b),
+        "REPAINT turned soft-wrapped rows into hard line breaks"
+    );
+
+    // Reflow both viewers to 110x12 without server assistance: both must unwrap onto single rows.
+    a.resize(110, 12, 0, 0).unwrap();
+    b.resize(110, 12, 0, 0).unwrap();
+    assert_eq!(plain(&a), plain(&b), "reflow after REPAINT diverged from live viewer");
+}
